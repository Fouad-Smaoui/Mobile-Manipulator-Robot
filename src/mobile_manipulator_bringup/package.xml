<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_bringup</name>
  <version>1.0.0</version>
  <description>Top-level bringup: RViz-only display, and the three demonstration scenarios (teleoperation, autonomous navigation, mobile manipulation).</description>
  <maintainer email="fouad.smaoui@outlook.com">fouad-smaoui</maintainer>
  <license>CC0-1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mobile_manipulator_description</exec_depend>
  <exec_depend>mobile_manipulator_gazebo</exec_depend>
  <exec_depend>mobile_manipulator_control</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
