  <version>1.0.0</version>
  <description>Gazebo Classic simulation bringup: world, gazebo_ros2_control bridge plugin, spawn launch.</description>
  <maintainer email="fouad.smaoui@outlook.com">fouad-smaoui</maintainer>
  <license>CC0-1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>mobile_manipulator_description</exec_depend>
  <exec_depend>mobile_manipulator_control</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_ros2_control</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>xacro</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
