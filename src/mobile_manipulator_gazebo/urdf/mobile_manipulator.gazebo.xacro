<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="mobile_manipulator_gazebo">

  <!-- ###################################################################
       AUDIT FIX (round 1): the original repo used `libgazebo_ros_control.so`
       + `libgazebo_ros_diff_drive.so` + `libgazebo_ros_joint_state_publisher.so`,
       the ROS1-era Gazebo Classic plugin set. Combined with a
       controller_manager spawner call in the launch file expecting ROS2
       controllers, the two control paths fought each other.

       AUDIT FIX (round 2): the first fix replaced those with
       `gazebo_ros2_control` (the Gazebo *Classic* ROS2 bridge). That
       does not run on this project's actual test environments (ROS2
       Jazzy on WSL + Docker), which ship the new Gazebo Sim (Harmonic+)
       stack: `gazebo_ros`/`gazebo_ros2_control` are not packaged for
       Jazzy at all, only `ros_gz_sim`/`gz_ros2_control` are. Verified
       against the actually-installed ros-jazzy-gz-ros2-control package
       (plugin filename `gz_ros2_control-system`, class
       `gz_ros2_control::GazeboSimROS2ControlPlugin`; hardware interface
       plugin `gz_ros2_control/GazeboSimSystem`) rather than assumed.

       This single bridge plugin exposes the <ros2_control> hardware
       interfaces declared in mobile_manipulator_description to the real
       ros2_control stack (controller_manager, joint_state_broadcaster,
       diff_drive_controller, joint_trajectory_controller). Gazebo Sim
       runs no competing native diff-drive plugin.
       ################################################################### -->

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find mobile_manipulator_control)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ###################################################################
       LiDAR sensor (Scenario B / Nav2 + SLAM). Real, not a placeholder:
       a `lidar_link` now exists in base.xacro (mounted at the base
       front), so this sensor block is enabled by default. Topic is
       `/scan` directly (not `/perception/scan`) to match what
       mobile_manipulator_bringup/config/nav2_params.yaml's costmaps and
       slam_toolbox both expect out of the box: no remap needed.
       The world-level `gz-sim-sensors-system` plugin (already loaded in
       mobile_manipulator_world.world) is what actually runs this sensor;
       this block only declares it on the link.
       ################################################################### -->
  <gazebo reference="lidar_link">
    <sensor type="gpu_lidar" name="lidar">
      <topic>/scan</topic>
      <!-- AUDIT FIX: gz-sim stamps the published LaserScan with its own
           auto-generated scoped frame ("mobile_manipulator/base_link/lidar"),
           not "lidar_link", the frame robot_state_publisher actually
           publishes via TF. Nav2's costmap and slam_toolbox both call tf2
           lookupTransform() using the scan message's frame_id, so an
           unmatched frame_id silently breaks both with no Gazebo-side
           error. Tried fixing it here with a `<gz_frame_id>lidar_link</gz_frame_id>`
           element (confirmed to be the right keyword by `strings` on
           libgz-sensors8.so.8); verified by an actual run that
           sdformat's URDF->SDF converter silently drops it before the
           sensor ever sees it (`gz_frame_id` is not a recognized SDF
           schema element for <sensor>, unlike <ros2_control>, which has
           explicit pass-through support). Fixed instead with a static
           transform publisher bridging the two frame names in
           gazebo_sim.launch.py, since they are physically coincident. -->
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>true</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- #################### Perception roadmap hook (camera) ############
       Camera still genuinely absent: no camera_link exists in
       base.xacro/arm.xacro. Left as a placeholder; not enabled.

  <gazebo reference="camera_link">
    <sensor type="camera" name="rgb_camera"/>
  </gazebo>
  ##################################################################### -->

</robot>
