<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="mobile_manipulator_arm">

  <!-- ###################################################################
       5-DOF arm mounted on base_link.

       AUDIT FIX: the original xacro declared every arm joint as
       `type="continuous"` (copy-pasted from the wheel-joint macro) and
       attached the arm to a dangling `world` link *in addition to* a
       second joint attaching it to `base_link` — i.e. the arm had two
       parents, which is an invalid kinematic tree and would fail
       `check_urdf` / MoveIt's kinematic model loading.

       Fixed here:
         - single parent (base_link) via one fixed mount joint
         - all actuated joints are `revolute` with real position limits
         - velocity/effort limits added so ros2_control and any future
           trajectory planner has bounds to respect
       ################################################################### -->

  <link name="arm_mount"/>
  <joint name="arm_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="arm_mount"/>
    <origin xyz="0.20 0.0 0.145" rpy="0 0 0"/>
  </joint>

  <link name="arm_base">
    <inertial>
      <origin xyz="7.7128E-09 -0.063005 -3.01969999961422E-08" rpy="0 0 0"/>
      <mass value="1.6004"/>
      <inertia
        ixx="0.00552196561445819" ixy="7.9550614501301E-10" ixz="-1.34378458924839E-09"
        iyy="0.00352397447953875" iyz="-1.10071809773382E-08" izz="0.00553739792746489"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/arm_base.stl"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/arm_base.stl"/></geometry>
    </collision>
  </link>

  <joint name="arm_base_joint" type="revolute">
    <!-- waist yaw -->
    <axis xyz="0 0 1"/>
    <parent link="arm_mount"/>
    <child link="arm_base"/>
    <origin xyz="0 0 0.1" rpy="0 0 0"/>
    <limit lower="-3.05" upper="3.05" effort="60.0" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <link name="bicep">
    <inertial>
      <origin xyz="0.12821 3.5589E-06 0.052492" rpy="0 0 0"/>
      <mass value="1.1198"/>
      <inertia
        ixx="0.0012474" ixy="-5.4004E-07" ixz="-0.0013148"
        iyy="0.0072923" iyz="-1.8586E-07" izz="0.0068178"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/bicep.stl"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 -1.5708 0"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/bicep.stl"/></geometry>
    </collision>
  </link>

  <joint name="shoulder_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <parent link="arm_base"/>
    <child link="bicep"/>
    <origin xyz="-0.05166 0.0 0.20271" rpy="0 0 1.5708"/>
    <limit lower="-1.57" upper="1.57" effort="60.0" velocity="2.0"/>
    <dynamics damping="0.3" friction="0.1"/>
  </joint>

  <link name="bottom_wrist">
    <inertial>
      <origin xyz="-9.1053E-08 -0.069257 -1.86629999995759E-07" rpy="0 0 0"/>
      <mass value="0.27721"/>
      <inertia
        ixx="0.00104290750143942" ixy="4.37155302268076E-09" ixz="-2.45049603914627E-09"
        iyy="0.000380518373895034" iyz="-7.56009835172156E-09" izz="0.00106006525067445"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.13522" rpy="3.14 0 1.5708"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/wrist.stl"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.13522" rpy="3.14 0 1.5708"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/wrist.stl"/></geometry>
    </collision>
  </link>

  <joint name="bottom_wrist_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <parent link="bicep"/>
    <child link="bottom_wrist"/>
    <origin xyz="0.0 -0.05194 0.269" rpy="0 0 0"/>
    <limit lower="-2.5" upper="2.5" effort="30.0" velocity="2.5"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="elbow">
    <inertial>
      <origin xyz="-0.11109 1.1476E-08 0.046469" rpy="0 0 0"/>
      <mass value="0.84845"/>
      <inertia
        ixx="0.00079656" ixy="-7.8011E-10" ixz="0.00053616"
        iyy="0.003576" iyz="4.6326E-10" izz="0.0033698"/>
    </inertial>
    <visual>
      <origin xyz="0.0 0.05163 0.20994" rpy="0 -1.5708 0"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/elbow.stl"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.05163 0.20994" rpy="0 -1.5708 0"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/elbow.stl"/></geometry>
    </collision>
  </link>

  <joint name="elbow_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <parent link="bottom_wrist"/>
    <child link="elbow"/>
    <origin xyz="0.0 0 0.13522" rpy="0 0 0"/>
    <limit lower="0.0" upper="2.62" effort="40.0" velocity="2.5"/>
    <dynamics damping="0.2" friction="0.1"/>
  </joint>

  <link name="top_wrist">
    <inertial>
      <origin xyz="-9.1053E-08 -0.069257 -1.86629999995759E-07" rpy="0 0 0"/>
      <mass value="0.27721"/>
      <inertia
        ixx="0.00104290750143942" ixy="4.37155302268076E-09" ixz="-2.45049603914627E-09"
        iyy="0.000380518373895034" iyz="-7.56009835172156E-09" izz="0.00106006525067445"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.13522" rpy="3.14 0 1.5708"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/wrist.stl"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.13522" rpy="3.14 0 1.5708"/>
      <geometry><mesh filename="package://mobile_manipulator_description/meshes/wrist.stl"/></geometry>
    </collision>
  </link>

  <joint name="top_wrist_joint" type="revolute">
    <axis xyz="0 0 1"/>
    <parent link="elbow"/>
    <child link="top_wrist"/>
    <origin xyz="0.0 0 0.20994" rpy="0 0 0"/>
    <limit lower="-3.05" upper="3.05" effort="20.0" velocity="3.0"/>
    <dynamics damping="0.1" friction="0.05"/>
  </joint>

  <!-- end-effector mount frame: this is the gripper attachment point.
       No gripper hardware exists yet — see roadmap in
       mobile_manipulator_hardware/doc/HARDWARE.md -->
  <link name="tool0"/>
  <joint name="tool0_joint" type="fixed">
    <parent link="top_wrist"/>
    <child link="tool0"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

</robot>
