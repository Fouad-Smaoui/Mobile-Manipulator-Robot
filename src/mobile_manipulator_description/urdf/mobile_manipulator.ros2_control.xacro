<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="mobile_manipulator_ros2_control">

  <!-- ###################################################################
       ros2_control hardware description.

       This is the single source of truth for which joints are actuated
       and what command/state interfaces they expose. The SAME xacro is
       used for simulation and for real hardware: only the <hardware>
       plugin name changes, selected by the `sim_mode` argument:

         sim_mode=true  -> gz_ros2_control/GazeboSimSystem   (Gazebo Sim / Harmonic+, ROS2 Jazzy)
         sim_mode=false -> mobile_manipulator_hardware/MobileManipulatorSystem
                            (real hardware, see mobile_manipulator_hardware
                            package; not yet implemented, see HARDWARE.md)

       This is the mechanism that makes the "simulation now, real robot
       later" promise concrete rather than aspirational: the controllers
       (diff_drive_controller, joint_trajectory_controller) are written
       against this interface, not against Gazebo, so swapping the
       <hardware> block is the only change needed to move from sim to
       physical actuators.
       ################################################################### -->

  <xacro:macro name="wheel_joint_interface" params="name">
    <joint name="${name}">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="arm_joint_interface" params="name">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </xacro:macro>

  <xacro:macro name="mobile_manipulator_ros2_control" params="sim_mode:=true">

    <ros2_control name="MobileManipulatorSystem" type="system">
      <hardware>
        <xacro:if value="${sim_mode}">
          <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </xacro:if>
        <xacro:unless value="${sim_mode}">
          <plugin>mobile_manipulator_hardware/MobileManipulatorSystem</plugin>
          <param name="motor_port">/dev/ttyUSB0</param>
          <param name="motor_baud">1000000</param>
        </xacro:unless>
      </hardware>

      <!-- Base: 4x velocity-controlled drive wheels -->
      <xacro:wheel_joint_interface name="front_left_wheel_joint"/>
      <xacro:wheel_joint_interface name="front_right_wheel_joint"/>
      <xacro:wheel_joint_interface name="rear_left_wheel_joint"/>
      <xacro:wheel_joint_interface name="rear_right_wheel_joint"/>

      <!-- Arm: 5x position-controlled revolute joints -->
      <xacro:arm_joint_interface name="arm_base_joint"/>
      <xacro:arm_joint_interface name="shoulder_joint"/>
      <xacro:arm_joint_interface name="bottom_wrist_joint"/>
      <xacro:arm_joint_interface name="elbow_joint"/>
      <xacro:arm_joint_interface name="top_wrist_joint"/>

    </ros2_control>

  </xacro:macro>

</robot>
