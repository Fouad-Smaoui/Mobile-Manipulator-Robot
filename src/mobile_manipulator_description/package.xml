<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mobile_manipulator_description</name>
  <version>1.0.0</version>
  <description>URDF/xacro kinematic, visual and inertial description of the mobile manipulator (4-wheel differential-drive base + 5-DOF arm). Simulation- and hardware-agnostic: contains no Gazebo plugins.</description>
  <maintainer email="fouad.smaoui@outlook.com">fouad-smaoui</maintainer>
  <license>CC0-1.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
